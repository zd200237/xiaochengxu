# =======================================================
# 📦 微信小程序 .gitignore（增强版）
# 适用于 WeChat Mini Program / 微信开发者工具
# =======================================================

# --- macOS 系统文件 ---
.DS_Store

# --- IDE / 编辑器配置 ---
.idea/
.vscode/

# --- 微信开发者工具配置与备份 ---
project.config.json.backup
project.private.config.json
project.private.config.json.backup
project.private.*
project.private.config.*
sitemap.json

# --- 依赖包 / 构建目录 ---
node_modules/
miniprogram_npm/
dist/
build/

# --- 锁文件（包管理器）---
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- 日志文件 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- 临时文件 / 缓存 ---
Thumbs.db

# --- 上传、打包生成的中间文件（如果你使用了构建工具）---
*.zip
*.tar
*.gz
