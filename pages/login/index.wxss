.login-bg {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
}
.login-header {
  text-align: center;
  margin-top: 130rpx;
  margin-bottom: 120rpx;
}
.login-title {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}
.main-login-btns {
  width: 80vw;
  position: absolute;
  left: 50%;
  top: 66%;
  transform: translate(-50%, -50%);
  margin: 0;
  text-align: center;
}
.wechat-btn {
  width: 100%;
  height: 100rpx;
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.wechat-btn[disabled] {
  background: #cccccc;
  color: #fff;
}
.login-tip {
  color: #f7f7f7;
  font-size: 28rpx;
}
.account-login-fab {
  position: fixed;
  right: 50rpx;
  bottom: 70rpx;
  background: #fff;
  color: #667eea;
  box-shadow: 0 8rpx 32rpx 0 rgba(80,80,120,0.13);
  padding: 14rpx 28rpx 14rpx 20rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  z-index: 999;
  opacity: 0.92;
  cursor: pointer;
}
.fab-icon { font-size: 34rpx; margin-right: 10rpx; }
.fab-label { font-size: 27rpx; }
.account-login-modal {
  position: fixed; left: 0; top: 0;
  width: 100vw; height: 100vh;
  z-index: 9999;
}
.modal-mask {
  position: absolute;
  width: 100vw; height: 100vh;
  left: 0; top: 0;
  background: rgba(0,0,0,0.35);
}
.modal-content {
  position: absolute;
  left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 80vw; min-width: 330rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 30rpx #7e7e9a33;
  padding: 32rpx 26rpx 22rpx;
}
.form-group { margin-bottom: 28rpx; }
.input-field {
  width: 100%; height: 100rpx; background: #f4f6fa;
  border-radius: 22rpx; padding: 0 8rpx; font-size: 30rpx;
  border: none;
}
.login-btn, .modal-close-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 16rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
}
.login-btn {
  background: #667eea;
  color: #fff;
  border: none;
}
.modal-close-btn {
  background: #eee;
  color: #333;
  border: none;
}
.login-btn[disabled] {
  background: #cccccc;
  color: #fff;
}
.error-msg {
  color: #ff3750;
  font-size: 26rpx;
  text-align: center;
  margin-top: 10rpx;
}
