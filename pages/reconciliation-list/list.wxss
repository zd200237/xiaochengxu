/* pages/reconciliation-list/list.wxss (最终版 - 带单据类型) */
page {
  background-color: #f7f8fa;
}
.container {
  padding: 24rpx;
}
.month-selector {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.month-nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.month-nav-btn {
  min-width: 90rpx;
  height: 54rpx;
  margin: 0 16rpx;
  font-size: 26rpx;
  padding: 0 10rpx;
  background: #f0f4fc;
  color: #3173e0;
  border-radius: 10rpx;
  border: none;
}
.month-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 44rpx;
  background: #fff;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: bold;
}
.arrow-down {
  width: 32rpx;
  height: 32rpx;
}
.summary-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.summary-item {
  display: flex;
  flex-direction: column;
}
.label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.value {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
}
.value.bold {
  font-weight: bold;
}

/* 时间轴主体容器 */
.timeline-wrapper {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
/* 表头 */
.list-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  position: sticky;
  top: 0;
  background-color: #fff;
  z-index: 10;
  border-bottom: 1px solid #f2f2f2;
}
/* 时间轴列表 */
.timeline-list {
  padding: 0 30rpx;
}
.timeline-item {
  display: flex;
  padding: 24rpx 0;
}
/* 左侧日期和轴线 */
.item-left {
  width: 100rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.date-text {
  font-size: 24rpx;
  color: #666;
}
.line-node {
  flex: 1;
  width: 2rpx;
  background-color: #e0e0e0;
  position: relative;
}
.node {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ccc;
  position: absolute;
  left: 50%;
  top: 20rpx;
  transform: translateX(-50%);
}
.node.type-2 { background-color: #52c41a; } /* 收款单节点颜色 */
.node.type-1 { background-color: #fa5151; } /* 应收单节点颜色 */

/* 右侧详情卡片 */
.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  border: 1px solid #f0f0f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-left: 20rpx;
}
.info-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  white-space: nowrap;
  margin-bottom: 2rpx; /* 紧凑行间距 */
}
.source-no {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 55%;
  margin-right: 10rpx;
}
.amount {
  font-size: 28rpx;
  font-weight: bold;
  white-space: nowrap;
  flex-shrink: 0;
}
.type-2 { color: #409615; } /* 绿色文字 */
.type-1 { color: #fa5151; } /* 红色文字 */

/* --- 单据类型和源单号的样式 --- */
.sub-info-line {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.type-badge {
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  color: #fff;
}
.type-badge.type-1 { /* 应收单 */
  background-color: #fa5151;
}
.type-badge.type-2 { /* 收款单 */
  background-color: #23b92f;
}
.out-in-source {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
}
/* ------------------------------- */

.desc-line {
  margin-top: 8rpx;
  margin-bottom: -20rpx;
}
.balance-label {
  font-size: 26rpx;
  color: #333;
}
.balance {
  font-size: 26rpx;
  color: #333;
}
.loading-tip, .empty-tip {
  text-align: center;
  padding-top: 100rpx;
  color: #999;
}
.balance-line {
  justify-content: flex-end;
  margin-top: 0rpx;
  font-size: 30rpx;
  color: rgb(55, 43, 228);
}