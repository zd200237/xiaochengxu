page {
  background-color: #f7f8fa;
}
.container { padding: 0; }

/* --- 头部样式 --- */
.header {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.kuanhao {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}
.product-name {
  font-size: 28rpx;
  color: #666;
}

/* --- 列表容器通栏 --- */
.list-container {
  background-color: #fff;
  width: 100vw;  /* 让白色背景紧贴屏幕左右 */
  margin-left: calc(-50vw + 50%);
  margin-right: calc(-50vw + 50%);
}

/* --- 表头 + 行样式，内容左右 30rpx 安全距离 --- */
.list-header, .list-row {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.list-header { color: #999; background: #fafbfc; }
.list-row { border-top: 1px solid #f2f2f2; color: #333; }

/* 列宽和对齐 */
.col-color { width: 28%; text-align: center; }
.col-size  { width: 22%; text-align: center; }
.col-qty   { width: 20%; text-align: center; }
.col-amount{ width: 30%; text-align: center; font-weight: 500; }

/* 订单主信息金额高亮（可选） */
.amount {
  color: #ff2d4b;
  font-weight: bold;
}
