/* pages/video/player/player.wxss (最终调整版) */
.page-container, .video-swiper, .swiper-item-wrapper {
  width: 100vw;
  height: 100vh;
  background-color: #000;
}

.swiper-item-wrapper {
  position: relative;
}

.fullscreen-video {
  width: 100%;
  height: 100%;
}

/* --- 核心修改区域 --- */
.download-fab {
  position: absolute;
  right: 40rpx;
  /* 1. 位置更靠下 */
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  /* 2. 背景色透明度降低 (更不透明) */
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
/* --- 修改结束 --- */

.fab-icon {
  width: 50rpx;
  height: 50rpx;
}