/* pages/video/list.wxss (卡片样式版) */
.page-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f7f8fa;
}
.season-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.season-card {
  width: calc(50% - 12rpx);
  height: 135rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #d8d8d8;
  position: absolute;
  top: 28rpx;
  right: 28rpx;
}
.status-dot.active {
  background-color: #4cd964;
}
.card-content {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
}
.season-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.video-count {
  display: block;
  font-size: 28rpx;
  color: #999;
}