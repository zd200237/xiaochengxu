.page-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6f9fd 0%, #f1f7ff 100%);
  padding-top: 36rpx;
}
.home-header {
  width: 92vw;
  max-width: 98vw;
  margin: 0 auto 50rpx auto;
  font-size: 34rpx;
  text-align: left;
  color: #495778;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  font-weight: 300;
}
.agent-name {
  font-size: 42rpx;
  font-weight: bold;
  color: #222;
  margin-left: 14rpx;
}
.home-card-panel {
  width: 92vw;
  max-width: 98vw;
  margin: 0 auto;
}
.home-menu-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 46rpx 32rpx;
  justify-items: center;
}
.home-menu-card {
  width: 298rpx;
  height: 150rpx;
  border-radius: 32rpx;
  background: rgba(245,250,255,0.82);
  box-shadow: 0 6rpx 28rpx 0 rgba(56,97,237,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  backdrop-filter: blur(2px);
  transition: box-shadow 0.18s, background 0.17s;
}
.home-menu-card:active {
  background: #f0f7ff;
  box-shadow: 0 2rpx 12rpx rgba(27,58,115,0.11);
}
.menu-title {
  color: #202d44;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx #fff8;
}
.menu-icon {
  display: block;
  width: 60rpx;
  height: 60rpx;
  margin-top: 10rpx;
  margin-bottom: 2rpx;
  /* 可用网络svg、iconfont、或自行替换为本地图片 */
  background: none
}
