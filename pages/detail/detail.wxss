/* pages/detail/detail.wxss */
.container {
  padding-bottom: 140rpx;
}

.image-swiper {
  width: 100%;
  /* 关键修改：给一个固定的高度，比如800rpx，您可以根据喜好调整这个数值 */
  height: 800rpx; 
}

.slide-image {
  width: 100%;
  height: 100%;
}

/* ... 下方的其他样式保持不变 ... */
.detail-info-card { margin: 20rpx; padding: 10rpx 30rpx; background-color: #ffffff; border-radius: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); }
.product-item { padding: 30rpx 0; border-bottom: 1px solid #f0f2f5; }
.product-item:last-child { border-bottom: none; }
.product-title-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.product-style-id { font-size: 32rpx; font-weight: bold; color: #333; }
.product-price { font-size: 36rpx; font-weight: bold; color: #e64340; }
.product-name { font-size: 28rpx; color: #666; margin-bottom: 10rpx; }
.product-desc { font-size: 26rpx; color: #999; line-height: 1.5; }
.action-bar { position: fixed; bottom: 0; left: 0; width: 100%; background-color: #ffffff; padding: 20rpx; box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05); box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }
.download-btn { background-color: #07c160; color: white; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }