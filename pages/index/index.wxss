.page-container {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  padding-bottom: calc(242rpx + env(safe-area-inset-bottom)); /* 预留底部空间，避免内容被底部栏遮住 */
  background: linear-gradient(to bottom, #f3fbfe 0%, #ffffff 100%);
  display: flex;
  flex-direction: column;
}

/* 内容区域自动撑开 */
.content-area {
  flex: 1 0 auto;
  padding-top: 14rpx;
}
.global-search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 42rpx;
}
.search-input {
  flex: 2;
  height: 82rpx;
  background: rgba(255,255,255,0.88);
  border-radius: 18rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
  border: 1.5px solid #e4eafe;
  box-shadow: 0 4rpx 12rpx rgba(120,170,255,0.04);
}
.search-button {
  flex: 1;
  height: 82rpx;
  margin-left: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(90deg, #2af598 0%, #009efd 100%);
  color: white;
  font-size: 32rpx;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 158, 253, 0.18);
  transition: all 0.18s cubic-bezier(.76,.01,.45,.98);
  font-weight: 500;
}
.search-button:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 11rpx rgba(0, 158, 253, 0.25);
}

.brand-grid,
.buyershow-grid,
.video-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx 0;
}

.glass-card {
  width: calc(50% - 12rpx);
  height: 146rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(245,247,250,0.98) 80%, rgba(224,235,255,0.85) 100%);
  box-shadow: 0 8rpx 28rpx 0 rgba(100,140,220,0.09),
              0 2rpx 9rpx 0 rgba(96,180,250,0.07);
  margin-bottom: 10rpx;
  position: relative;
  border: 1.5rpx solid rgba(80,140,240,0.11);
  overflow: hidden;
  backdrop-filter: blur(7rpx);
  transition: box-shadow 0.18s, transform 0.12s;
}
.glass-card:active {
  box-shadow: 0 3rpx 14rpx #66aaff24;
  transform: scale(0.985);
}
.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(90deg,#dadfe6 30%,#e7edfa 100%);
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  box-shadow: 0 0 8rpx #f2f7fb;
  border: 1rpx solid #e0ecfd;
  transition: background .22s cubic-bezier(.7,0,.5,1);
}
.status-dot.active {
  background: linear-gradient(90deg,#5ee884 40%,#42c9ec 100%);
  box-shadow: 0 0 14rpx 5rpx #eafee7;
  border: 1rpx solid #5ee884;
}
.card-content {
  position: absolute;
  top: 50%;
  left: 30rpx;
  transform: translateY(-50%);
  width: 80%;
}
.brand-name,
.buyershow-name,
.video-season-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #263554;
  letter-spacing: 2rpx;
  text-shadow: 0 1.5rpx 3rpx #e6eefa66;
  line-height: 40rpx;
}
.loading-tip {
  text-align: center;
  color: #adb3c7;
  padding-top: 200rpx;
  font-size: 28rpx;
}

/* --- 视频号入口网格 --- */
.channels-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.channels-logo {
  position: absolute;
  right: 18rpx;
  top: 23%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  opacity: 1;
}

/* --- 底部功能栏 --- */
.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(15rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 1000;
  padding: 0 24rpx;
}
.bottom-tabbar-inner {
  width: 100%;
  max-width: 660rpx;
  height: 110rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(40, 80, 130, 0.18);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.tab-item {
  flex: 1;
  height: 100%;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7893;
  font-size: 22rpx;
  transition: transform 0.18s, background 0.18s, color 0.18s;
  margin: 0 2rpx;
  box-sizing: border-box;
}
.tab-item:active {
  transform: scale(0.96);
}
.tab-item.active {
  color: #0b571d;
  background: linear-gradient(135deg, rgba(76, 176, 255, 0.18) 0%, rgba(140, 210, 255, 0.28) 100%);
}
.tab-item.active .tab-text {
  color: #0b571d;
}
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 5rpx;
}
.tab-text {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  font-weight: 600;
  color: #2f3a55;
}

/* 仅用于“朋友圈素材”图标的小样式，不影响其他结构 */
.moments-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  display: inline-block;
  vertical-align: middle;
}
