/* pages/list/list.wxss (Grid布局最终版) */

/* ... 搜索栏样式不变 ... */
.search-bar { display: flex; align-items: center; position: relative; padding: 0 20rpx; margin-bottom: 20rpx; }
.search-input { width: 100%; height: 72rpx; background-color: #ffffff; border-radius: 36rpx; padding-left: 30rpx; padding-right: 60rpx; font-size: 28rpx; box-sizing: border-box; border: 1px solid #e9e9e9; }
.clear-btn { position: absolute; right: 30rpx; top: 50%; transform: translateY(-50%); width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 36rpx; color: #bbbbbb; }

/* ✨ 关键修改：调整container的内边距 */
.container {
  padding: 5rpx; /* 整个页面距离屏幕边缘的距离 */
  background-color: #f0f2f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ✨ 关键修改：使用Grid布局重写列表容器 */
.list-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 定义两列，每列占据可用空间的一半 */
  gap: 20rpx; /* 定义卡片之间的横向和纵向间隙 */
}

/* --- 卡片样式 --- */
.group-item {
  width: 100%; /* 宽度自动填满Grid分配的单元格 */
  background-color: #ffffff;
  border-radius: 16rpx;
  /* margin不再需要，由gap属性控制 */
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ... 剩下的 .cover-image, .info-area 等样式保持不变 ... */
.cover-image { width: 100%; display: block; vertical-align: top; }
.info-area { padding: 16rpx; }
.product-info { margin-bottom: 16rpx; border-bottom: 1px solid #f0f2f5; padding-bottom: 16rpx; }
.product-info:last-child { margin-bottom: 0; border-bottom: none; padding-bottom: 0; }
.product-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.style-id { font-size: 24rpx; color: #333; font-weight: bold; word-break: break-all; }
.price { font-size: 28rpx; color: #e64340; font-weight: bold; margin-left: 10rpx; white-space: nowrap; }
.product-name { font-size: 22rpx; color: #888; }
