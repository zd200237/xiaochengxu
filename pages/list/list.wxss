/* pages/list/list.wxss (终极UI版) */
page {
  background-color: #f7f8fa;
}
.list-page-container {
  padding: 20rpx;
}
.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}
.search-input {
  height: 72rpx;
  background-color: #fff;
  border-radius: 36rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
}
.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ccc;
}
.list-wrapper {
  display: flex;
  justify-content: space-between;
}
.waterfall-column {
  width: 48%;
  display: flex;
  flex-direction: column;
}
.group-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.group-item:active {
  opacity: 0.8;
}
.cover-image {
  width: 100%;
}
.info-area {
  padding: 20rpx;
}
.product-info {
  margin-bottom: 10rpx;
}
.product-info:last-child {
  margin-bottom: 0;
}
.product-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.style-id {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.price {
  font-size: 26rpx;
  color: #fa5151;
  font-weight: bold;
}

/* --- 核心修改 --- */
.product-name-line {
  display: flex;
  align-items: baseline; /* 基线对齐，让文字和标签对齐更自然 */
  flex-wrap: wrap; /* 如果空间不足，允许换行 */
}
.product-name {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  margin-right: 12rpx; /* 与“已定”标签拉开距离 */
}
.ordered-section {
  display: flex;
  align-items: baseline;
  /* 移除之前的边框和边距 */
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}
.ordered-badge {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
  padding: 2rpx 8rpx; /* 微调padding */
  font-size: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.ordered-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.color-tag {
  font-size: 20rpx;
  color: #666;
}
/* -------------------- */

.loading-tip, .empty-tip {
  width: 100%;
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}