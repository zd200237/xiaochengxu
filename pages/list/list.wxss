/* pages/list/list.wxss */
.search-bar{display:flex;align-items:center;position:relative;margin-bottom:20rpx}.search-input{width:100%;height:72rpx;background-color:#fff;border-radius:36rpx;padding-left:30rpx;padding-right:60rpx;font-size:28rpx;box-sizing:border-box;border:1px solid #e9e9e9}.clear-btn{position:absolute;right:20rpx;top:50%;transform:translateY(-50%);width:40rpx;height:40rpx;line-height:40rpx;text-align:center;font-size:36rpx;color:#bbb}

/* ✨✨✨ 使用专属类名，并在这里调整与屏幕的边距 ✨✨✨ */
.list-page-container {
  padding: 20rpx;
  background-color: #f0f2f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ✨✨✨ 瀑布流布局：使用双列容器 ✨✨✨ */
.list-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.waterfall-column {
  width: calc(50% - 10rpx); /* 两列，中间留20rpx间隙 */
  display: flex;
  flex-direction: column;
}

.group-item {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.05);
  box-sizing: border-box;
  margin-bottom: 20rpx; /* 纵向间隙 */
}

.cover-image{width:100%;display:block;vertical-align:top}.info-area{padding:2rpx}.product-info{margin-bottom:2rpx;border-bottom:1px solid #f0f2f5;padding-bottom:3rpx}.product-info:last-child{margin-bottom:0;border-bottom:none;padding-bottom:0}.product-line{display:flex;justify-content:space-between;align-items:center;margin-bottom:0rpx}.style-id{font-size:24rpx;color:#333;font-weight:700;word-break:break-all}.price{font-size:28rpx;color:#e64340;font-weight:700;margin-left:10rpx;white-space:nowrap}.product-name{font-size:22rpx;color:#888}