.page-container {
  padding: 40rpx 32rpx;
  background: #f6f8fb;
  min-height: 100vh;
}

/* 门店标题 */
.store-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* 表头 */
.table-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 36rpx;
  background: #e9eef5;
  border-radius: 18rpx;
  margin-bottom: 28rpx;
}

.header-left,
.header-right {
  font-size: 32rpx;
  color: #555;
  font-weight: 600;
}

.loading,
.empty {
  text-align: center;
  color: #888;
  margin-top: 200rpx;
  font-size: 30rpx;
}

/* 数据卡片 */
.item-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.05);
}

.left {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.right {
  font-size: 34rpx;
  color: #f44336;
  font-weight: 600;
}