/* pages/show/list.wxss (更新后) */
.page-container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}
.loading-tip, .empty-tip {
  text-align: center;
  color: #999;
  padding-top: 200rpx;
}

/* --- 卡片网格布局 --- */
.list-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* --- 白色卡片主体 (与首页样式一致) --- */
.list-card {
  width: calc(50% - 12rpx);
  height: 135rpx; /* 固定高度，保持规整 */
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  transition: transform 0.2s, box-shadow 0.2s;
}
.list-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* --- 右上角状态指示灯 --- */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #d8d8d8; /* 默认灰色 (无内容) */
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  transition: all 0.3s;
}
.status-dot.active {
  background-color: #4cd964; /* 有内容时变为绿色 */
  box-shadow: 0 0 12rpx rgba(76, 217, 100, 0.6);
}

/* --- 卡片文字内容区域 --- */
.card-content {
  /* 定位到卡片左下角 */
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
}
.card-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.card-count {
  display: block;
  font-size: 28rpx;
  color: #999;
}